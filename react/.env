REACT_APP_LOGIN_WS=wss://finex.dk/ps2l/
REACT_APP_WS=wss://finex.dk/ps2/
# Assuming /ps2d/ is the correct path for data based on pattern, adjust if needed
REACT_APP_URL_DATA=http://localhost:3002
# Assuming /ps2g/ is the correct path for guest based on pattern, adjust if needed
REACT_APP_GUEST_WS=wss://finex.dk/ps2g/

DANGEROUSLY_DISABLE_HOST_CHECK=true
PORT=3002

# Base URL of the reference manual (static export of help/, served by the ps2 server from
# server/public/help). When the client is deployed into server/public the two share an origin and
# this can simply be /help; the dev server runs on its own origin, so it needs the absolute URL.
REACT_APP_HELP_URL=https://localhost:3332/help
